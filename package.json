{
	"name": "chronos-ui-workspace",
	"private": true,
	"version": "0.0.7",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "DEVMODE=true bun run studio/src/server/index.ts",
		"start": "bun run studio/src/server/index.ts",
		"build:tome": "bun run studio/src/workers/compile_tome_ssg.ts",
		"build": "bun run build:tome && bun run --bun vite build",
		"preview": "bun run --bun vite preview --port=3000 --host=0.0.0.0",
		"lint": "bunx svelte-check --tsconfig ./tsconfig.json && bunx tsc --noEmit",
		"test": "bun test",
		"mcp:token": "bun run studio/src/workers/mint_mcp_token.ts",
		"mcp:stdio": "bun run studio/src/mcp/mcp.stdio.ts",
		"verify": "bun run studio/src/workers/qa_verify.ts",
		"qa:fast": "bun run studio/src/workers/qa_verify.ts --fast",
		"qa:delta": "bun run studio/src/workers/qa_verify.ts --delta",
		"qa:release": "bun run studio/src/workers/qa_verify.ts --release",
		"qa:report": "bun run studio/src/workers/qa_report.ts",
		"qa:timer": "bun run studio/src/workers/qa_timer.ts"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"drizzle-orm": "^0.45.4",
		"svelte": "^5.58.0",
		"tailwindcss": "^4.3.3",
		"vite": "^8.3.0"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/bun": "latest",
		"autoprefixer": "^10.4.21",
		"svelte-check": "^4.3.5",
		"typescript": "^5.8.3"
	}
}
